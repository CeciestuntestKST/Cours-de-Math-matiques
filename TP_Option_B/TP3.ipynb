   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "def g(x):\n",
    "  return x/2-np.sin(x)+np.pi/6-np.sqrt(3)/2\n",
    "\n",
    "\n",
    "x=np.linspace(-np.pi/2,np.pi,1000)\n",
    "plt.plot(x,g(x))\n",
    "plt.axhline(y=1)"
   ]
  }
